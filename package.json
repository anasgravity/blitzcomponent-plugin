{
  "name": "blitzcomponent-vite-plugin",
  "version": "1.0.0",
  "description": "Vite plugin that generates a BlitzData component for a React project.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub"
  },
  "keywords": [
    "vite-plugin",
    "vite",
    "blitzdata"
  ],
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "devDependencies": {
    "unbuild": "^2.0.0"
  }
}